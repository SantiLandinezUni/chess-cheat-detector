# Copy to .env and fill in. Never commit .env.
# Shared group key for player_id hashing (HMAC-SHA256). Get it privately from the repo owner;
# everyone must use the same value. Generate a new one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
LICHESS_HASH_KEY=

# PostgreSQL credentials (optional locally: empty PGUSER = your Mac username, no password)
PGUSER=
PGPASSWORD=
