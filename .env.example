# Copy to .env and fill in. Never commit .env.
# Shared group key for player_id hashing (HMAC-SHA256). Get it privately from the repo owner;
# everyone must use the same value. Generate a new one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
LICHESS_HASH_KEY=

# Optional Lichess personal API token for collect_labels.py (higher /api/users limits when authenticated).
# Create one with no scopes at https://lichess.org/account/oauth/token. Leave empty for anonymous requests.
LICHESS_API_TOKEN=

# PostgreSQL credentials (optional locally: empty PGUSER = your Mac username, no password)
PGUSER=
PGPASSWORD=
